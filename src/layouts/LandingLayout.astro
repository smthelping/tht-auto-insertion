---
import PageLayout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';

import { headerData } from '~/navigation';
import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  language?: string;
  direction?: string;
}

const { metadata, language, direction } = Astro.props;

// This site is a single product line, so every page carries the full navigation
// (machine groups, overview, catalogue, videos) rather than the template's
// reduced "Landing" menu.
const links = headerData?.links;
---

<PageLayout metadata={metadata} language={language} direction={direction}>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>
  <Fragment slot="announcement">
    <slot name="announcement" />
  </Fragment>
  <Fragment slot="header">
    <slot name="header">
      <Header links={links} showToggleTheme position="right" />
    </slot>
  </Fragment>
  <slot />
</PageLayout>
