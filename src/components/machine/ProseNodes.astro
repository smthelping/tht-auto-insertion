---
import type { MachineNode } from '~/utils/machines';
import { translate, translateItem } from '~/utils/machines';

export interface Props {
  nodes: MachineNode[];
  dict?: Record<string, string>;
  /** Heading already rendered by the wrapper, so it is not repeated here. */
  skip?: string;
}

const { nodes, dict = {}, skip = '' } = Astro.props;

// The first heading of a block becomes the section title in BlockRenderer.
const visible = nodes.filter((node, index) => {
  const isHeading = node.t === 'h1' || node.t === 'h2';
  return !(index === 0 && isHeading && node.text === skip);
});

const listClass = (ordered: boolean) =>
  `${ordered ? 'list-decimal' : 'list-disc'} ms-5 mb-5 space-y-2 text-muted marker:text-primary`;
---

<div class="max-w-4xl">
  {
    visible.map((node) => {
      const text = translate(node, dict);

      if (node.t === 'h2') {
        return <h2 class="mt-10 mb-4 text-2xl font-bold text-heading md:text-3xl first:mt-0" set:html={text} />;
      }
      if (node.t === 'h3') {
        return <h3 class="mt-8 mb-3 text-xl font-bold text-heading first:mt-0" set:html={text} />;
      }
      if (node.t === 'h4' || node.t === 'h5') {
        return <h4 class="mt-6 mb-2 text-lg font-semibold text-heading first:mt-0" set:html={text} />;
      }
      if (node.t === 'p') {
        return <p class="mb-4 leading-relaxed text-muted last:mb-0" set:html={text} />;
      }
      if (node.t === 'ul' || node.t === 'ol') {
        const ordered = node.t === 'ol';
        return (
          <ul class={listClass(ordered)} style={ordered ? 'list-style:decimal' : undefined}>
            {(node.items ?? []).map((item) => (
              <li set:html={translateItem(item, dict)} />
            ))}
          </ul>
        );
      }
      if (node.t === 'table') {
        return (
          <div class="mb-8 overflow-x-auto rounded-lg border border-gray-200 dark:border-slate-700">
            <table class="w-full border-collapse text-left text-sm">
              {node.caption && (
                <caption class="px-4 py-3 text-left text-base font-bold text-heading">
                  {translate(node, dict, 'caption')}
                </caption>
              )}
              {node.head && node.head.length > 0 && (
                <thead class="bg-gray-50 dark:bg-slate-800">
                  <tr>
                    {node.head.map((cell) => (
                      <th class="whitespace-nowrap px-4 py-3 font-semibold text-heading">{cell}</th>
                    ))}
                  </tr>
                </thead>
              )}
              <tbody>
                {(node.rows ?? []).map((row) => (
                  <tr class="border-t border-gray-100 align-top dark:border-slate-700/70">
                    {row.map((cell, cellIndex) => (
                      <td
                        class:list={['px-4 py-3', cellIndex === 0 ? 'font-medium text-heading' : 'text-muted']}
                        set:html={translateItem(cell, dict)}
                      />
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        );
      }
      if (node.t === 'faq') {
        return (
          <details class="group mb-2 rounded-lg border border-gray-200 px-4 py-3 dark:border-slate-700">
            <summary class="cursor-pointer font-semibold text-heading marker:content-none">
              <span set:html={translate(node, dict, 'q') || text} />
            </summary>
            <p class="mt-3 mb-0 text-muted" set:html={translate(node, dict, 'a')} />
          </details>
        );
      }
      if (node.t === 'kv') {
        return (
          <dl class="mb-6 grid gap-2 sm:grid-cols-[minmax(0,14rem)_1fr]">
            {(node.items ?? []).map((item) => (
              <>
                <dt class="font-semibold text-heading">{translateItem({ key: item.key, text: item.t }, dict)}</dt>
                <dd class="mb-3 text-muted sm:mb-0" set:html={translateItem({ key: item.key, text: item.d }, dict)} />
              </>
            ))}
          </dl>
        );
      }
      if (node.t === 'link') {
        return (
          <a
            class="mb-2 inline-block font-medium text-primary hover:underline"
            href={node.href}
            target="_blank"
            rel="noopener"
          >
            {text}
          </a>
        );
      }
      if (text) {
        return <p class="mb-4 leading-relaxed text-muted" set:html={text} />;
      }
      return null;
    })
  }
</div>
