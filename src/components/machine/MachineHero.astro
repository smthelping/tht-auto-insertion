---
/**
 * Hero in the AstroWind idiom (badge → headline → content → actions → image),
 * but rendering the machine photograph as a plain <img>. The machine photos
 * live on the company image host; keeping them as plain <img> keeps the build
 * hermetic (no remote fetch, no Sharp pass in CI) and matches how the original
 * single-file pages served them.
 */
export interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  tagline?: string;
  content?: string;
  image?: { src: string; alt: string };
  actions?: { text: string; href: string; variant?: 'primary' | 'secondary' }[];
  id?: string;
}

const { badge, title, subtitle, tagline, content, image, actions = [], id } = Astro.props;

const actionClass = (variant: string | undefined) =>
  variant === 'secondary'
    ? 'rounded-md border border-gray-300 px-5 py-3 font-semibold text-heading transition hover:border-primary dark:border-slate-600'
    : 'rounded-md bg-primary px-5 py-3 font-semibold text-white transition hover:bg-primary/90';
---

<section class="relative not-prose" {...id ? { id } : {}}>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <div class="py-12 md:py-20">
      <div class="mx-auto max-w-5xl pb-10 text-center md:pb-14">
        {
          badge && (
            <span class="mb-4 inline-block rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary dark:bg-primary/25 dark:text-blue-200">
              {badge}
            </span>
          )
        }
        {tagline && <p class="mb-2 text-base font-bold uppercase tracking-wide text-secondary dark:text-blue-200">{tagline}</p>}
        <h1 class="mb-5 text-balance text-4xl font-bold leading-tighter tracking-tighter text-heading md:text-5xl">{title}</h1>
        {subtitle && <p class="mb-6 text-xl text-muted">{subtitle}</p>}
        {content && <p class="mx-auto max-w-3xl text-muted">{content}</p>}
        {
          actions.length > 0 && (
            <div class="mt-8 flex flex-wrap justify-center gap-3">
              {actions.map((action) => (
                <a class={actionClass(action.variant)} href={action.href}>
                  {action.text}
                </a>
              ))}
            </div>
          )
        }
      </div>

      {
        image?.src && (
          <div class="mx-auto max-w-5xl">
            <img
              src={image.src}
              alt={image.alt}
              width="1200"
              height="675"
              fetchpriority="high"
              decoding="async"
              class="w-full rounded-lg bg-gray-100 object-cover shadow-lg dark:bg-slate-800"
            />
          </div>
        )
      }
    </div>
  </div>
</section>
